    <SecurityChunk mps:id="4D4OnF0cUhC" name="07-Ethernet">
        <Elements>
            <AttackStep attackFeasibilityLevel="High" completeAttackFeasibility="Knowledge:K0(0), Opportunity:W0(0), Expertise:Ex3(3), Equipment:Eq2(2), Time:T1(1)" description="The attacker obtains (purchases or builds) a device that can be used to connect to and read packets on an automotive ethernet communication line.&#10;This device can only be used for listening to communication.&#10;&#10;Automotive ethernet is quite similar to standard ethernet, the main difference relevant here is that automotive ethernet uses different connectors, &#10;only two nodes are ever on a cable (point-to-point topology) and master/slave and speed is often not autonegotiated.&#10;Like standard ethernet, automotive ethernet can also have VLANs (providing segmentation and priorities), CRC checksums.&#10;Automotive application-level protocols include SOME/IP (Scalable service-Oriented MiddlewarE over IP) for the support of service oriented transmission of data, &#10;TSN (Time-Sensitive Networking) for low-latency transmission of streaming data (e.g. camera picture) and&#10;DoIP (Diagnostics over IP) specified in ISO13400 that is used e.g. for fast flashing." mps:id="5eRSwfFEqSK" name="ASC.0701" title="Obtain Automotive Ethernet compatible device for reading packets">
                <InstantiatedClass>
                    <ThreatClassRef mps:id="5eRSwfFErqp" target="mps/r:bba387ab-3691-413e-99bf-ee48f7411463(GenericCatalog)/6_b5OdN$zgD"/>
                </InstantiatedClass>
                <ActedOnTOEEs/>
                <InitialFeasibilityOptions>
                    <FeasibilityRating category="name/FeasibilityCategory/Knowledge" mps:id="5eRSwfFEs9W" option="name/FeasibilityOption/K0(0)"/>
                    <FeasibilityRating category="name/FeasibilityCategory/Opportunity" mps:id="5eRSwfFEsaK" option="name/FeasibilityOption/W0(0)"/>
                    <FeasibilityRating category="name/FeasibilityCategory/Expertise" mps:id="5eRSwfFEsf3" option="name/FeasibilityOption/Ex3(3)"/>
                    <FeasibilityRating category="name/FeasibilityCategory/Equipment" mps:id="5eRSwfFEsj9" option="name/FeasibilityOption/Eq2(2)"/>
                    <FeasibilityRating category="name/FeasibilityCategory/Time" mps:id="5eRSwfFEsn2" option="name/FeasibilityOption/T1(1)"/>
                </InitialFeasibilityOptions>
                <ConsecutiveFeasibilityOptions/>
                <ExplicitInitialFeasibility/>
                <ExplicitConsecutiveFeasibility/>
