            <AttackStep attackFeasibilityLevel="Medium" completeAttackFeasibility="Knowledge:K2(2), Opportunity:W5(5), Expertise:Ex2(2), Equipment:Eq6(6), Time:T4(4)" description="This attack spoofs a brake demand request on the CAN communication &#10;between the EPMs and the GSBC ECU, allowing an attacker to activate &#10;the brakes remotely. The main requirement for this attack, beyond &#10;identifying the correct message through reverse engineering, is &#10;calculating the correct CRC for the message. However, this is achievable &#10;through message replay attacks." mps:id="2e6hrLrk6iG" name="ASC.0417" title="DPRES">
                <InstantiatedClass>
                    <ThreatClassRef mps:id="2e6hrLrk77A" target="mps/r:bba387ab-3691-413e-99bf-ee48f7411463(GenericCatalog)/1HkBurD3Udx"/>
                </InstantiatedClass>
                <ActedOnTOEEs/>
                <InitialFeasibilityOptions>
