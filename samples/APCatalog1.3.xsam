            <AttackStep attackFeasibilityLevel="High" completeAttackFeasibility="Knowledge:K2(2), Opportunity:W0(0), Expertise:Ex4(4), Equipment:Eq4(4), Time:T2(2)" description="This step involves the exploration of communication order and timing (enforced by the LIN master), the transmitted signals and the signal ranges." mps:id="1kgZy0eq2yS" name="ASC.0503" title="Identification of communication details on the LIN bus">
                <InstantiatedClass>
                    <ThreatClassRef mps:id="6wwZ3i9h44t" target="mps/r:bba387ab-3691-413e-99bf-ee48f7411463(GenericCatalog)/6_b5OdN$zgD"/>
