    <SecurityChunk mps:id="5El8qyGrLzX" name="01-Analog signals">
        <Elements>
            <AttackStep attackFeasibilityLevel="High" completeAttackFeasibility="Knowledge:K0(0), Opportunity:W0(0), Expertise:Ex1(1), Equipment:Eq4(4), Time:T1(1)" description="The attacker has to build or purchase a device that is able to manipulate analog signal values. In some cases it is needed that this device is able to set the signal level continuously." mps:id="6b9CcRfGK7s" name="ASC.0101" title="Obtain malicious device for tampering with analog signals">
                <InstantiatedClass>
                    <ThreatClassRef mps:id="3RcQOIlsu$3" target="mps/r:bba387ab-3691-413e-99bf-ee48f7411463(GenericCatalog)/6_b5OdN$zgD"/>
                </InstantiatedClass>
                <ActedOnTOEEs/>
                <InitialFeasibilityOptions>
                    <FeasibilityRating category="name/FeasibilityCategory/Knowledge" mps:id="QV5ZxHb7hR" option="name/FeasibilityOption/K0(0)" rationale="No additional knowledge of the ToE is required to obtain a device that is compatible with a given physical layer."/>
                    <FeasibilityRating category="name/FeasibilityCategory/Opportunity" mps:id="QV5ZxHb7tr" option="name/FeasibilityOption/W0(0)" rationale="The window of opportunity is unlimited, because the attacker can perform this step remotely and in advance."/>
                    <FeasibilityRating category="name/FeasibilityCategory/Expertise" mps:id="QV5ZxHb7CN" option="name/FeasibilityOption/Ex1(1)" rationale="All the necessary information are available online that is necessary for purchasing or building one such device. "/>
                    <FeasibilityRating category="name/FeasibilityCategory/Equipment" mps:id="QV5ZxHbaiI" option="name/FeasibilityOption/Eq4(4)" rationale="In the best case (from the perspective of the attacker) no equipment is required for purchasing or building the device."/>
                    <FeasibilityRating category="name/FeasibilityCategory/Time" mps:id="QV5ZxHbaJ1" option="name/FeasibilityOption/T1(1)" rationale="Purchasing or building one such device is expected to take a considerable amount of time (longer than a day), because the item may not be available instantly."/>
                </InitialFeasibilityOptions>
                <ConsecutiveFeasibilityOptions/>
                <ExplicitInitialFeasibility/>
                <ExplicitConsecutiveFeasibility/>
                <CustomImpactCombinator/>
                <CustomFeasibilityCombinator/>
                <FeasibilityModel/>
                <Todos/>
                <ImplementedVulnerabilities/>
            </AttackStep>
            <AttackStep attackFeasibilityLevel="High" completeAttackFeasibility="Knowledge:null, Opportunity:null, Expertise:null, Equipment:null, Time:null" description="The attacker connects the malicious device to any analog lines on the vehicle frame." mps:id="6b9CcRfH3Wi" name="ASC.0102" refinedBy="ASC.0003" title="Connect malicious device to analog lines">
                <InstantiatedClass>
