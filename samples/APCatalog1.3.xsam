<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<mps:RootNodes xmlns="http://www.security-analyst.org/xsam" xmlns:mps="http://www.itemis.de/mps" mps:coreVersion="96" mps:modelRef="r:ee95e1e2-caed-415b-9410-4e775b311389(APCatalog1.3)" mps:toolVersion="26.1">
    <SecurityChunk mps:id="5El8qyGrtPP" name="00-Initial access, generic">
        <Elements>
            <AttackStep attackFeasibilityLevel="High" completeAttackFeasibility="Knowledge:K1(1), Opportunity:W5(5), Expertise:Ex0(0), Equipment:Eq2(2), Time:T0(0)" description="The attacker locates the ECU and opens its cover to access its internals." mps:id="5El8qyGrtPR" name="ASC.0001" title="Accessing the internals of the ECU (on the vehicle frame)">
                <InstantiatedClass>
                    <ThreatClassRef mps:id="3RcQOIlswKl" target="mps/r:bba387ab-3691-413e-99bf-ee48f7411463(GenericCatalog)/6_b5OdN$zgD"/>
                </InstantiatedClass>
                <ActedOnTOEEs/>
                <InitialFeasibilityOptions>
                    <FeasibilityRating category="name/FeasibilityCategory/Equipment" mps:id="QV5ZxHbjPZ" option="name/FeasibilityOption/Eq2(2)" rationale="More equipment is required to open the ECU than to access it on the vehicle frame."/>
                    <FeasibilityRating category="name/FeasibilityCategory/Knowledge" mps:id="5_lnabUsnP5" option="name/FeasibilityOption/K1(1)"/>
                    <FeasibilityRating category="name/FeasibilityCategory/Opportunity" mps:id="5_lnabUsnV7" option="name/FeasibilityOption/W5(5)"/>
                    <FeasibilityRating category="name/FeasibilityCategory/Expertise" mps:id="5_lnabUso0X" option="name/FeasibilityOption/Ex0(0)"/>
                    <FeasibilityRating category="name/FeasibilityCategory/Time" mps:id="5_lnabUso6B" option="name/FeasibilityOption/T0(0)"/>
                </InitialFeasibilityOptions>
                <ConsecutiveFeasibilityOptions/>
                <ExplicitInitialFeasibility/>
                <ExplicitConsecutiveFeasibility/>
                <CustomImpactCombinator/>
                <CustomFeasibilityCombinator/>
                <FeasibilityModel/>
                <Todos/>
                <ImplementedVulnerabilities/>
            </AttackStep>
            <AttackStep attackFeasibilityLevel="High" completeAttackFeasibility="Knowledge:K0(0), Opportunity:W0(0), Expertise:Ex0(0), Equipment:Eq4(4), Time:T1(1)" description="The attacker obtains an ECU to support further exploits. This attack step is required to perform attack steps &quot;on test bench&quot;.&#10;&#10;The most feasible way to do this is by purchasing the ECU (e.g. order it online)." mps:id="5El8qyGrtSw" name="ASC.0002" title="Obtain an ECU (removed from the vehicle)">
                <InstantiatedClass>
                    <ThreatClassRef mps:id="3RcQOIlswT5" target="mps/r:bba387ab-3691-413e-99bf-ee48f7411463(GenericCatalog)/6_b5OdN$zgD"/>
                </InstantiatedClass>
                <ActedOnTOEEs/>
                <InitialFeasibilityOptions>
                    <FeasibilityRating category="name/FeasibilityCategory/Knowledge" mps:id="QV5ZxHbifQ" option="name/FeasibilityOption/K0(0)" rationale="No special knowledge is assumed for the initial access."/>
                    <FeasibilityRating category="name/FeasibilityCategory/Opportunity" mps:id="QV5ZxHbioX" option="name/FeasibilityOption/W0(0)" rationale="The window of opportunity is not limited, because the ECU is removed from the vehicle. The attack can work offline."/>
                    <FeasibilityRating category="name/FeasibilityCategory/Time" mps:id="QV5ZxHbixS" option="name/FeasibilityOption/T1(1)" rationale="This attack step assumes that the attacker has to obtain an ECU, which is likely to take a longer time."/>
                    <FeasibilityRating category="name/FeasibilityCategory/Expertise" mps:id="QV5ZxHbiNa" option="name/FeasibilityOption/Ex0(0)" rationale="No special expertise is required for the initial access."/>
                    <FeasibilityRating category="name/FeasibilityCategory/Equipment" mps:id="gvQG$2ye95" option="name/FeasibilityOption/Eq4(4)"/>
                </InitialFeasibilityOptions>
                <ConsecutiveFeasibilityOptions/>
                <ExplicitInitialFeasibility/>
                <ExplicitConsecutiveFeasibility/>
                <CustomImpactCombinator/>
                <CustomFeasibilityCombinator/>
                <FeasibilityModel/>
                <Todos/>
                <ImplementedVulnerabilities/>
            </AttackStep>
            <AttackStep attackFeasibilityLevel="High" completeAttackFeasibility="Knowledge:K1(1), Opportunity:W5(5), Expertise:Ex0(0), Equipment:Eq1(1), Time:T0(0)" description="The attacker needs to have physical access to the vehicle. This attack step involves accessing any component on the vehicle frame (CAN bus, frame ECUs, sensors)." mps:id="5El8qyGrtW9" name="ASC.0003" title="Accessing components on the vehicle frame">
                <InstantiatedClass>
                    <ThreatClassRef mps:id="3RcQOIlsxaj" target="mps/r:bba387ab-3691-413e-99bf-ee48f7411463(GenericCatalog)/6_b5OdN$zgD"/>
                </InstantiatedClass>
                <ActedOnTOEEs/>
                <InitialFeasibilityOptions>
                    <FeasibilityRating category="name/FeasibilityCategory/Knowledge" mps:id="QV5ZxHbgeM" option="name/FeasibilityOption/K1(1)" rationale="Basic knowledge of the ToE is required to find the particular target ECU."/>
                    <FeasibilityRating category="name/FeasibilityCategory/Opportunity" mps:id="QV5ZxHbgWT" option="name/FeasibilityOption/W5(5)" rationale="By definition."/>
                    <FeasibilityRating category="name/FeasibilityCategory/Expertise" mps:id="QV5ZxHbhKg" option="name/FeasibilityOption/Ex0(0)" rationale="No expertise is required for the initial access."/>
                    <FeasibilityRating category="name/FeasibilityCategory/Equipment" mps:id="QV5ZxHbhTV" option="name/FeasibilityOption/Eq1(1)" rationale="Only the bare minimum is required in terms of equipment."/>
                    <FeasibilityRating category="name/FeasibilityCategory/Time" mps:id="QV5ZxHbi3q" option="name/FeasibilityOption/T0(0)" rationale="The attack step requires only a short period of time, likely less than an hour."/>
                </InitialFeasibilityOptions>
                <ConsecutiveFeasibilityOptions/>
                <ExplicitInitialFeasibility/>
                <ExplicitConsecutiveFeasibility/>
                <CustomImpactCombinator/>
                <CustomFeasibilityCombinator/>
                <FeasibilityModel/>
                <Todos/>
                <ImplementedVulnerabilities/>
            </AttackStep>
            <AttackStep attackFeasibilityLevel="High" completeAttackFeasibility="Knowledge:K1(1), Opportunity:W7(7), Expertise:Ex0(0), Equipment:Eq1(1), Time:T0(0)" description="The attacker needs to have physical access to components under the cabin. It is less feasible to access components under the cabin, than on the vehicle frame.&#10;&#10;The higher level attack steps are created with the &quot;Accessing components on the vehicle frame&quot; attack step. So this attack step may be connected in an &quot;AND&quot; relationship to higher level attack steps to reflect the higher attack potential in the &quot;Window of opportunity&quot; factor." mps:id="5El8qyGru0M" name="ASC.0004" title="Accessing components under the cabin">
                <InstantiatedClass>
                    <ThreatClassRef mps:id="3RcQOIlsxj3" target="mps/r:bba387ab-3691-413e-99bf-ee48f7411463(GenericCatalog)/6_b5OdN$zgD"/>
                </InstantiatedClass>
                <ActedOnTOEEs/>
                <InitialFeasibilityOptions>
                    <FeasibilityRating category="name/FeasibilityCategory/Knowledge" mps:id="QV5ZxHbfNQ" option="name/FeasibilityOption/K1(1)" rationale="Basic knowledge of the ToE is required to find the particular target ECU."/>
                    <FeasibilityRating category="name/FeasibilityCategory/Opportunity" mps:id="QV5ZxHbh7w" option="name/FeasibilityOption/W7(7)" rationale="By definition."/>
                    <FeasibilityRating category="name/FeasibilityCategory/Expertise" mps:id="QV5ZxHbhhY" option="name/FeasibilityOption/Ex0(0)" rationale="No expertise is required for the initial access."/>
                    <FeasibilityRating category="name/FeasibilityCategory/Equipment" mps:id="QV5ZxHbhsg" option="name/FeasibilityOption/Eq1(1)" rationale="Only the bare minimum is required in terms of equipment."/>
                    <FeasibilityRating category="name/FeasibilityCategory/Time" mps:id="QV5ZxHbhAm" option="name/FeasibilityOption/T0(0)" rationale="The attack step requires only a short period of time, likely less than a few hours."/>
                </InitialFeasibilityOptions>
                <ConsecutiveFeasibilityOptions/>
                <ExplicitInitialFeasibility/>
                <ExplicitConsecutiveFeasibility/>
                <CustomImpactCombinator/>
                <CustomFeasibilityCombinator/>
                <FeasibilityModel/>
                <Todos/>
                <ImplementedVulnerabilities/>
            </AttackStep>
            <AttackStep attackFeasibilityLevel="High" completeAttackFeasibility="Knowledge:K1(1), Opportunity:W9(9), Expertise:Ex0(0), Equipment:Eq0(0), Time:T0(0)" description="To carry out some further attack steps, the attacker has to enter the cabin." mps:id="5El8qyGru6r" name="ASC.0005" title="Entering the cabin">
                <InstantiatedClass>
                    <ThreatClassRef mps:id="3RcQOIlsxjl" target="mps/r:bba387ab-3691-413e-99bf-ee48f7411463(GenericCatalog)/6_b5OdN$zgD"/>
                </InstantiatedClass>
                <ActedOnTOEEs/>
                <InitialFeasibilityOptions>
                    <FeasibilityRating category="name/FeasibilityCategory/Expertise" mps:id="5eplkSw0ma8" option="name/FeasibilityOption/Ex0(0)" rationale="No expertise is required for entering the cabin."/>
                    <FeasibilityRating category="name/FeasibilityCategory/Time" mps:id="5eplkSw0n9A" option="name/FeasibilityOption/T0(0)" rationale="The attack step can be executed in minimal time, if the proper opportunity is available."/>
                    <FeasibilityRating category="name/FeasibilityCategory/Knowledge" mps:id="73loQJtI3lq" option="name/FeasibilityOption/K1(1)"/>
                    <FeasibilityRating category="name/FeasibilityCategory/Equipment" mps:id="73loQJtI41b" option="name/FeasibilityOption/Eq0(0)"/>
                    <FeasibilityRating category="name/FeasibilityCategory/Opportunity" mps:id="73loQJtI6WD" option="name/FeasibilityOption/W9(9)"/>
                </InitialFeasibilityOptions>
                <ConsecutiveFeasibilityOptions/>
                <ExplicitInitialFeasibility/>
                <ExplicitConsecutiveFeasibility/>
                <CustomImpactCombinator/>
                <CustomFeasibilityCombinator/>
                <FeasibilityModel/>
                <Todos/>
                <ImplementedVulnerabilities/>
            </AttackStep>
            <AttackStep attackFeasibilityLevel="Medium" completeAttackFeasibility="Knowledge:K0(0), Opportunity:W0(0), Expertise:Ex7(7), Equipment:Eq4(4), Time:T6(6)" description="This attack step considers a scenario in which another node is compromised on the CAN bus. This may grant remote access to an attacker to our device.&#10;&#10;The feasibility ratings here are only estimates, because the source of the attack is out of scope for the analysis. An attack against a telematics unit is assumed, as a typical worst case scenario." mps:id="5El8qyGrx3k" name="ASC.0006" title="Launching attack from a compromised CAN node">
                <InstantiatedClass>
                    <ThreatClassRef mps:id="3RcQOIlsxjB" target="mps/r:bba387ab-3691-413e-99bf-ee48f7411463(GenericCatalog)/6_b5OdN$zgD"/>
                </InstantiatedClass>
                <ActedOnTOEEs/>
                <InitialFeasibilityOptions>
                    <FeasibilityRating category="name/FeasibilityCategory/Knowledge" mps:id="5eplkSw0ob5" option="name/FeasibilityOption/K0(0)"/>
                    <FeasibilityRating category="name/FeasibilityCategory/Opportunity" mps:id="5eplkSw0oFN" option="name/FeasibilityOption/W0(0)"/>
                    <FeasibilityRating category="name/FeasibilityCategory/Expertise" mps:id="5eplkSw0pnf" option="name/FeasibilityOption/Ex7(7)"/>
                    <FeasibilityRating category="name/FeasibilityCategory/Equipment" mps:id="5eplkSw0pRR" option="name/FeasibilityOption/Eq4(4)"/>
                    <FeasibilityRating category="name/FeasibilityCategory/Time" mps:id="5eplkSw0qo7" option="name/FeasibilityOption/T6(6)"/>
                </InitialFeasibilityOptions>
                <ConsecutiveFeasibilityOptions/>
                <ExplicitInitialFeasibility/>
                <ExplicitConsecutiveFeasibility/>
                <CustomImpactCombinator/>
                <CustomFeasibilityCombinator/>
                <FeasibilityModel/>
                <Todos/>
                <ImplementedVulnerabilities/>
            </AttackStep>
            <AttackStep attackFeasibilityLevel="Medium" completeAttackFeasibility="Knowledge:K0(0), Opportunity:W0(0), Expertise:Ex7(7), Equipment:Eq4(4), Time:T6(6)" description="If the ECU only has a LIN interface (no CAN), then remote attacks will reach it from the LIN master. The LIN master may be reprogrammed or tricked into transferring messages from a CAN network.&#10;&#10;The feasibility ratings here are only estimates, because the source of the attack is out of scope for the analysis." mps:id="5El8qyGrx4G" name="ASC.0007" title="Launching attack from a compromised LIN master">
                <InstantiatedClass>
                    <ThreatClassRef mps:id="3RcQOIlsxjT" target="mps/r:bba387ab-3691-413e-99bf-ee48f7411463(GenericCatalog)/6_b5OdN$zgD"/>
                </InstantiatedClass>
                <ActedOnTOEEs/>
                <InitialFeasibilityOptions>
                    <FeasibilityRating category="name/FeasibilityCategory/Knowledge" mps:id="5eplkSw0qZN" option="name/FeasibilityOption/K0(0)"/>
                    <FeasibilityRating category="name/FeasibilityCategory/Opportunity" mps:id="5eplkSw0r0O" option="name/FeasibilityOption/W0(0)"/>
                    <FeasibilityRating category="name/FeasibilityCategory/Expertise" mps:id="5eplkSw0r1D" option="name/FeasibilityOption/Ex7(7)"/>
                    <FeasibilityRating category="name/FeasibilityCategory/Equipment" mps:id="5eplkSw0r2i" option="name/FeasibilityOption/Eq4(4)"/>
                    <FeasibilityRating category="name/FeasibilityCategory/Time" mps:id="5eplkSw0r2J" option="name/FeasibilityOption/T6(6)"/>
                </InitialFeasibilityOptions>
                <ConsecutiveFeasibilityOptions/>
                <ExplicitInitialFeasibility/>
                <ExplicitConsecutiveFeasibility/>
                <CustomImpactCombinator/>
                <CustomFeasibilityCombinator/>
                <FeasibilityModel/>
                <Todos/>
                <ImplementedVulnerabilities/>
            </AttackStep>
            <AttackStep attackFeasibilityLevel="Low" completeAttackFeasibility="Knowledge:K2(2), Opportunity:W7(7), Expertise:Ex5(5), Equipment:Eq4(4), Time:T2(2)" description="This attack step considers the effort taken to synchronize an attack with a critical driving maneuver.&#10;This can involve complex logic in the attacking device or remote connection.&#10;&#10;But most importantly, critical driving maneuvers do not happen very frequently, so this attack step limits the Window of Opportunity score.&#10;The basis of this estimation is a HARA (GSBC) which considers Emergency Braking situations with E2 exposure. &#10;E2 exposure means either &quot;&lt;1% of operating time&quot; or &quot;Low probability&quot;. This is interpreted as a WoO score of 7 / 10.&#10;&#10;Knowledge 2: No confidential information is needed for this.&#10;Experience 5: A deeper understanding is required.&#10;Equipment 4: Equipment is not cheap but can be freely ordered.&#10;Time 2: Preparation can happen in two weeks." mps:id="13rKzaPc0Zw" name="ASC.0008" title="Synchronize attack with critical driving maneuver - frame">
                <InstantiatedClass>
                    <ThreatClassRef mps:id="13rKzaPc12n" target="mps/r:bba387ab-3691-413e-99bf-ee48f7411463(GenericCatalog)/6_b5OdN$zgD"/>
                </InstantiatedClass>
                <ActedOnTOEEs/>
                <InitialFeasibilityOptions>
                    <FeasibilityRating category="name/FeasibilityCategory/Knowledge" mps:id="13rKzaPc12p" option="name/FeasibilityOption/K2(2)"/>
                    <FeasibilityRating category="name/FeasibilityCategory/Opportunity" mps:id="13rKzaPc12s" option="name/FeasibilityOption/W7(7)"/>
                    <FeasibilityRating category="name/FeasibilityCategory/Expertise" mps:id="13rKzaPc12v" option="name/FeasibilityOption/Ex5(5)"/>
                    <FeasibilityRating category="name/FeasibilityCategory/Equipment" mps:id="13rKzaPc12y" option="name/FeasibilityOption/Eq4(4)"/>
                    <FeasibilityRating category="name/FeasibilityCategory/Time" mps:id="13rKzaPc12_" option="name/FeasibilityOption/T2(2)"/>
                </InitialFeasibilityOptions>
                <ConsecutiveFeasibilityOptions/>
                <ExplicitInitialFeasibility/>
                <ExplicitConsecutiveFeasibility/>
                <CustomImpactCombinator/>
                <CustomFeasibilityCombinator/>
                <FeasibilityModel/>
                <Todos/>
                <ImplementedVulnerabilities/>
            </AttackStep>
            <AttackStep attackFeasibilityLevel="Low" completeAttackFeasibility="Knowledge:K2(2), Opportunity:W9(9), Expertise:Ex5(5), Equipment:Eq4(4), Time:T2(2)" description="This attack step considers the effort taken to synchronize an attack with a critical driving maneuver.&#10;This can involve complex logic in the attacking device or remote connection.&#10;&#10;But most importantly, critical driving maneuvers do not happen very frequently, so this attack step limits the Window of Opportunity score.&#10;The basis of this estimation is a HARA (GSBC) which considers Emergency Braking situations with E2 exposure. &#10;E2 exposure means either &quot;&lt;1% of operating time&quot; or &quot;Low probability&quot;. This is interpreted as a WoO score of 7 / 10.&#10;If the attack involves components under the cabin, the score is 9 / 10.&#10;&#10;Knowledge 2: No confidential information is needed for this.&#10;Experience 5: A deeper understanding is required.&#10;Equipment 4: Equipment is not cheap but can be freely ordered.&#10;Time 2: Preparation can happen in two weeks." mps:id="3RcQOIlstbi" name="ASC.0009" title="Synchronize attack with critical driving maneuver - under cabin">
                <InstantiatedClass>
                    <ThreatClassRef mps:id="3RcQOIlstdt" target="mps/r:bba387ab-3691-413e-99bf-ee48f7411463(GenericCatalog)/6_b5OdN$zgD"/>
                </InstantiatedClass>
                <ActedOnTOEEs/>
                <InitialFeasibilityOptions>
                    <FeasibilityRating category="name/FeasibilityCategory/Knowledge" mps:id="3RcQOIlstdu" option="name/FeasibilityOption/K2(2)"/>
                    <FeasibilityRating category="name/FeasibilityCategory/Opportunity" mps:id="3RcQOIlstdv" option="name/FeasibilityOption/W9(9)"/>
                    <FeasibilityRating category="name/FeasibilityCategory/Expertise" mps:id="3RcQOIlstdw" option="name/FeasibilityOption/Ex5(5)"/>
                    <FeasibilityRating category="name/FeasibilityCategory/Equipment" mps:id="3RcQOIlstdx" option="name/FeasibilityOption/Eq4(4)"/>
                    <FeasibilityRating category="name/FeasibilityCategory/Time" mps:id="3RcQOIlstdy" option="name/FeasibilityOption/T2(2)"/>
                </InitialFeasibilityOptions>
                <ConsecutiveFeasibilityOptions/>
                <ExplicitInitialFeasibility/>
                <ExplicitConsecutiveFeasibility/>
                <CustomImpactCombinator/>
                <CustomFeasibilityCombinator/>
                <FeasibilityModel/>
                <Todos/>
                <ImplementedVulnerabilities/>
            </AttackStep>
            <AttackStep attackFeasibilityLevel="High" completeAttackFeasibility="Knowledge:K0(0), Opportunity:W0(0), Expertise:Ex6(6), Equipment:Eq0(0), Time:T4(4)" description="This attack step represents the added complexity of executing an attack via multiple interfaces simultaneously.&#10;The preparation for the attack takes a longer time period and expert level expertise is required.&#10;Having to attack multiple interfaces at the same time also means that the design of the attack is more complex and more information needs to be gathered of the system." mps:id="13rKzaPc12C" name="ASC.0010" title="Synchronize multiple attack paths">
                <InstantiatedClass>
                    <ThreatClassRef mps:id="13rKzaPc13F" target="mps/r:bba387ab-3691-413e-99bf-ee48f7411463(GenericCatalog)/6_b5OdN$zgD"/>
                </InstantiatedClass>
                <ActedOnTOEEs/>
                <InitialFeasibilityOptions>
                    <FeasibilityRating category="name/FeasibilityCategory/Knowledge" mps:id="13rKzaPc13H" option="name/FeasibilityOption/K0(0)"/>
                    <FeasibilityRating category="name/FeasibilityCategory/Opportunity" mps:id="13rKzaPc13K" option="name/FeasibilityOption/W0(0)"/>
                    <FeasibilityRating category="name/FeasibilityCategory/Expertise" mps:id="13rKzaPc13N" option="name/FeasibilityOption/Ex6(6)"/>
                    <FeasibilityRating category="name/FeasibilityCategory/Equipment" mps:id="13rKzaPc13Q" option="name/FeasibilityOption/Eq0(0)"/>
                    <FeasibilityRating category="name/FeasibilityCategory/Time" mps:id="13rKzaPc13T" option="name/FeasibilityOption/T4(4)"/>
