            </AttackStep>
            <AttackStep attackFeasibilityLevel="High" completeAttackFeasibility="Knowledge:null, Opportunity:null, Expertise:null, Equipment:null, Time:null" description="Physical proximity and basic tooling is required." mps:id="1jQQJeVOWD5" name="ASC.0103" refinedBy="and(ASC.0102, ASC.0003)" title="TS - Denial of service against analog signals on vehicle frame (cutting)">
                <InstantiatedClass>
                    <ThreatClassRef mps:id="6wwZ3i9gIv7" target="mps/r:bba387ab-3691-413e-99bf-ee48f7411463(GenericCatalog)/1HkBurD3Ud_"/>
