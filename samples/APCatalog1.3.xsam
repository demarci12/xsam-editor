                <ImplementedVulnerabilities/>
            </AttackStep>
            <AttackStep attackFeasibilityLevel="Medium" completeAttackFeasibility="Knowledge:null, Opportunity:null, Expertise:null, Equipment:null, Time:null" description="It is assumed, that the attacker cannot tamper with the message schedule. The target message may be received and used by a LIN node other than the master.&#10;&#10;The attacker starts responding to the same header as the sender. The sender node stops sending the response, once a bit error is detected on the bus. Dominant bit is 0, so the attacker wants to start the injected message with 0 bits. Once the sender stops transmission, the attacker is able to transmit any payload." mps:id="1kgZy0eq1WK" name="ASC.0505" refinedBy="and(ASC.0502, ASC.0503, ASC.0508)" title="TS - Spoofing LIN responses (after the first byte)">
                <InstantiatedClass>
                    <ThreatClassRef mps:id="7Vzhsj_WZNO" target="mps/r:bba387ab-3691-413e-99bf-ee48f7411463(GenericCatalog)/1HkBurD3Udx"/>
                </InstantiatedClass>
                <ActedOnTOEEs/>
                <InitialFeasibilityOptions/>
                <ConsecutiveFeasibilityOptions/>
                <ExplicitInitialFeasibility/>
                <ExplicitConsecutiveFeasibility/>
                <CustomImpactCombinator/>
                <CustomFeasibilityCombinator/>
                <FeasibilityModel/>
                <Todos/>
                <ImplementedVulnerabilities/>
            </AttackStep>
            <AttackStep attackFeasibilityLevel="Medium" completeAttackFeasibility="Knowledge:null, Opportunity:null, Expertise:null, Equipment:null, Time:null" description="To allow free message manipulation of LIN requests, the attacker either removes the master from the bus and impersonates it. Or it disconnects a slave from the bus and impersonates the master towards that single node. &#10;&#10;Important notice: it is likely to be more complicated to impersonate the master for all the ECUs." mps:id="7Vzhsj_X6YI" name="ASC.0506" refinedBy="and(ASC.0501, ASC.0503, ASC.0502)" title="TS - Impersonating LIN Master">
                <InstantiatedClass>
                    <ThreatClassRef mps:id="3RcQOIltfY$" target="mps/r:bba387ab-3691-413e-99bf-ee48f7411463(GenericCatalog)/1HkBurD3Udx"/>
                </InstantiatedClass>
                <ActedOnTOEEs/>
                <InitialFeasibilityOptions/>
                <ConsecutiveFeasibilityOptions/>
                <ExplicitInitialFeasibility/>
                <ExplicitConsecutiveFeasibility/>
                <CustomImpactCombinator/>
                <CustomFeasibilityCombinator/>
                <FeasibilityModel/>
                <Todos/>
                <ImplementedVulnerabilities/>
            </AttackStep>
            <AttackStep attackFeasibilityLevel="Medium" completeAttackFeasibility="Knowledge:null, Opportunity:null, Expertise:null, Equipment:null, Time:null" description="To allow free message manipulation of LIN responses, the attacker removes the slave from the bus and generates the responses." mps:id="7Vzhsj_X7et" name="ASC.0507" refinedBy="and(ASC.0501, ASC.0503, ASC.0502)" title="TS - Impersonating LIN slave">
                <InstantiatedClass>
                    <ThreatClassRef mps:id="3RcQOIltg9y" target="mps/r:bba387ab-3691-413e-99bf-ee48f7411463(GenericCatalog)/1HkBurD3Udx"/>
